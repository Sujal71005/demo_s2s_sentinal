# ============================================================
# S2S SENTINELS — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# Google Earth Engine — Required for live Sentinel-1 SAR analysis
# Used by: /api/earth-engine/flood (GET and POST)
# All variables are server-side only. Never use NEXT_PUBLIC_ prefix.
# ------------------------------------------------------------

# Option A: Inline service account credentials (recommended for cloud deployments)
# EE_SERVICE_ACCOUNT_EMAIL = client_email from your GCP service account JSON key
# EE_SERVICE_ACCOUNT_KEY   = private_key field (include BEGIN/END PRIVATE KEY lines)
#                            Replace literal newlines with \n
EE_SERVICE_ACCOUNT_EMAIL=
EE_SERVICE_ACCOUNT_KEY=

# GCP project ID that has Earth Engine API enabled
GOOGLE_CLOUD_PROJECT=

# Option B: Path to a service account JSON key file on the server filesystem.
# If both Option A and Option B are set, Option B (file path) takes priority.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ------------------------------------------------------------
# Supabase — Optional. If not set, local GIS data generator is used.
# ------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# HOW TO GET EARTH ENGINE CREDENTIALS
# ============================================================
# 1. Create a Google Cloud project at https://console.cloud.google.com
# 2. Enable the Earth Engine API for your project
# 3. Create a Service Account with the "Earth Engine Resource Viewer" role
# 4. Generate a JSON key for the service account
# 5. Register the service account at https://code.earthengine.google.com/register
# 6. Copy client_email into EE_SERVICE_ACCOUNT_EMAIL
# 7. Copy private_key into EE_SERVICE_ACCOUNT_KEY (replace real newlines with \n)
# 8. Set GOOGLE_CLOUD_PROJECT to your project ID
# ============================================================
