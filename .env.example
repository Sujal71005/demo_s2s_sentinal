# Google Earth Engine credentials
# Required for live Sentinel-1 SAR flood analysis via /api/earth-engine/flood
#
# All three variables below are read server-side only.
# Never use NEXT_PUBLIC_ prefixes for these — they must never reach the browser.
#
# EE_SERVICE_ACCOUNT_EMAIL  — the "client_email" field from your service account JSON key
# EE_SERVICE_ACCOUNT_KEY    — the full "private_key" field (including BEGIN/END PRIVATE KEY lines)
# GOOGLE_CLOUD_PROJECT      — the GCP project ID that has Earth Engine enabled
EE_SERVICE_ACCOUNT_EMAIL=
EE_SERVICE_ACCOUNT_KEY=
GOOGLE_CLOUD_PROJECT=

# Optional alternative: path to a service account JSON key file on the server filesystem.
# If set, this takes priority over the inline variables above.
# GOOGLE_APPLICATION_CREDENTIALS=
